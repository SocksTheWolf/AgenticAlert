{
  "type": "module",
  "scripts": {
    "dev": "npx wrangler dev --live-reload",
    "build": "node --env-file-if-exists=.env SITEBUILD.js",
    "extbuild": "npx web-ext build -o -n extension.zip -a ext -i=\"*\" \"!src\" \"!icon*.png\" \"!LICENSE\" \"!manifest.json\"",
    "extrun": "npx web-ext run -a ext -i=\"*\" \"!src\" \"!icon*.png\" \"!LICENSE\" \"!manifest.json\"",
    "extlint": "npx web-ext lint -i=\"*\" \"!src\" \"!icon*.png\" \"!LICENSE\" \"!manifest.json\""
  },
  "devDependencies": {
    "web-ext": "^10.8.0",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "@actions/github": {
      "undici": "^7.30.1"
    },
    "@actions/http-client": {
      "undici": "^7.30.1"
    },
    "typescript-eslint": {
      "minimatch": "^11.0.1"
    },
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
