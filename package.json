{
  "type": "module",
  "scripts": {
    "dev": "npx wrangler dev --live-reload",
    "prebuild": "npx cpy agenticalert.user.js site && npx cpy icon64.png site/icon.png",
    "build": "node --env-file-if-exists=.env SITEBUILD.js",
    "extbuild": "npx web-ext build -o -n extension.zip -a ext -i=\"*\" \"!agenticalert.user.js\" \"!icon*.png\" \"!LICENSE\" \"!manifest.json\"",
    "extrun": "npx web-ext run -a ext -i=\"*\" \"!agenticalert.user.js\" \"!icon*.png\" \"!LICENSE\" \"!manifest.json\"",
    "extlint": "npx web-ext lint -i=\"*\" \"!agenticalert.user.js\" \"!icon*.png\" \"!LICENSE\" \"!manifest.json\""
  },
  "devDependencies": {
    "cpy-cli": "^7.0.0",
    "web-ext": "^10.8.0",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@actions/github": {
      "undici": "^7.30.1"
    },
    "@actions/http-client": {
      "undici": "^7.30.1"
    },
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
