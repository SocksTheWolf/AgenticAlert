{
  "manifest_version": 3,
  "name": "AgenticAlert",
  "description": "Puts a notice if an AI Agent was used in a GitHub repository",
  "version": "",
  "author": "SocksTheWolf",
  "developer": {
    "name": "SocksTheWolf",
    "url": "https://socksthewolf.com"
  },
  "homepage_url": "https://agenticalert.download/",
  "icons": {
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*",
        "https://www.github.com/*/*"
      ],
      "js": [
        "agenticalert.user.js"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "agenticalert@agenticalert.download",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "id": "agenticalert@agenticalert.download",
      "strict_min_version": "113.0"
    }
  }
}